{
  "manifest_version": 3,
  "name": "ApplyEase Autofill & Tracker",
  "version": "1.0.0",
  "description": "Autofill job application forms and log applications directly to your ApplyEase tracker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyEase"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*/*"
      ],
      "js": [
        "mapper.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
